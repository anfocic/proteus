# Pick one. The framework doesn't care which you use.

# --- Anthropic (commercial) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI-compatible endpoint (any host: Groq, Together, Cerebras, OpenRouter, Ollama, LM Studio, ...) ---
# Examples:
#   LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=llama-3.3-70b-versatile
#   LLM_BASE_URL=https://api.together.xyz/v1               LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   LLM_BASE_URL=https://api.cerebras.ai/v1                LLM_MODEL=llama-3.3-70b
#   LLM_BASE_URL=https://openrouter.ai/api/v1              LLM_MODEL=qwen/qwen-2.5-72b-instruct
#   LLM_BASE_URL=http://localhost:11434/v1                 LLM_MODEL=llama3.2     (Ollama)
#   LLM_BASE_URL=http://localhost:1234/v1                  LLM_MODEL=local-model  (LM Studio)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
