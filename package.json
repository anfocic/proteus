{
  "name": "proteus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Provider-agnostic agent framework — proof of concept",
  "scripts": {
    "demo": "node --env-file-if-exists=.env --import tsx demo/weather.ts",
    "demo:multi": "node --env-file-if-exists=.env --import tsx demo/multi-tool.ts",
    "demo:triage": "node --env-file-if-exists=.env --import tsx demo/triage.ts",
    "demo:chat": "node --env-file-if-exists=.env --import tsx demo/chat.ts",
    "demo:telegram": "node --env-file-if-exists=.env --import tsx demo/telegram.ts",
    "demo:telegram-confirm": "node --env-file-if-exists=.env --import tsx demo/telegram-confirm.ts",
    "demo:confirm": "node --env-file-if-exists=.env --import tsx demo/confirm.ts",
    "demo:stream": "node --env-file-if-exists=.env --import tsx demo/stream.ts",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
